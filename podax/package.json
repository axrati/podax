{
  "name": "podax",
  "version": "1.0.0",
  "description": "Offline desktop encryption for files and folders",
  "author": "axrati",
  "license": "MIT",
  "homepage": "https://github.com/axrati/podax",
  "repository": {
    "type": "git",
    "url": "https://github.com/axrati/podax.git"
  },
  "desktopName": "podax.desktop",
  "private": true,
  "main": "electron/main.cjs",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "concurrently --kill-others-on-fail \"vite --host 127.0.0.1 --strictPort\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/run-electron.cjs .\"",
    "clean": "node scripts/clean.cjs",
    "build": "vite build",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run lint && npm test && npm run build",
    "test": "npm run test:renderer && npm run test:main",
    "test:renderer": "vitest run",
    "test:main": "node --test electron/**/*.test.cjs",
    "test:watch": "vitest",
    "pack": "npm run build && node scripts/build-desktop.cjs --dir",
    "dist": "npm run build && node scripts/build-desktop.cjs",
    "dist:mac": "npm run build && node scripts/build-desktop.cjs --mac",
    "dist:win": "npm run build && node scripts/build-desktop.cjs --win",
    "dist:linux": "npm run build && node scripts/build-desktop.cjs --linux"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^27.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
